          "expr": "sum by (scheduled_job) (rate(jobs_run_seconds_sum{application=\"subscription-hub\"}[1h])) / sum by (scheduled_job) (rate(jobs_run_seconds_count{application=\"subscription-hub\"}[1h]))",
          "legendFormat": "{{scheduled_job}}"
