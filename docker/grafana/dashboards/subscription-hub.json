        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(hikaricp_connections_timeout_total{application=\"subscription-hub\"}[5m])",
          "legendFormat": "timeouts/s"
        }
