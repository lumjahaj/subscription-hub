            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (type) (increase(audit_events_total{application=\"subscription-hub\", type=~\"SUBSCRIPTION_PAST_DUE|SUBSCRIPTION_RECOVERED|SUBSCRIPTION_CANCELED\"}[1h]))",
