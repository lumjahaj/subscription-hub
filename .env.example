# Postgres. POSTGRES_USER is a superuser and owns the schema; it is what
# Flyway migrates as, and nothing else.
POSTGRES_USER=subscriptionhub
POSTGRES_PASSWORD=subscriptionhub
POSTGRES_DB=subscription_hub_db

# The role the application itself connects as at runtime: not a superuser, not
# the owner, and NOBYPASSRLS - so the row-level security policies actually
# apply to it. Created by docker/postgres/init/01-app-role.sh when the
# database is first initialised. The role NAME is fixed (the policies and
# grants in db/migration reference it), so only the password lives here.
POSTGRES_APP_PASSWORD=subscriptionhub-app

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin

# The local object store and queue, stated explicitly.
#
# Everything in this block follows one rule: "unset is the deployed value".
# These settings mean "ask the SDK to work it out" when absent - the real
# regional endpoint, the default credential chain - so they default to unset in
# application.yml and the LOCAL value lives here. A deployed host deletes these
# lines rather than blanking them, because an empty value is not portable: the
# PowerShell loader in the README deletes a variable given an empty string.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=subscriptionhub
STORAGE_SECRET_KEY=subscriptionhub
# s3mock serves path-style addressing; S3 wants virtual-host style.
STORAGE_PATH_STYLE=true
# s3mock and ElasticMQ both ignore credentials entirely, so the values above
# and below are placeholders - they only have to be non-blank.
SQS_ENDPOINT=http://localhost:9324
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# JWT signing (HS256 - must be at least 32 bytes)
JWT_SECRET=dev-only-jwt-secret-change-me-in-any-real-environment

# Stripe (optional). The default payment provider is the in-process fake,
# so none of this is needed to run the app or the tests. Set these only to
# run against the real Stripe API with payment.provider=stripe:
#   STRIPE_SECRET_KEY     test-mode secret key, sk_test_...
#   STRIPE_WEBHOOK_SECRET printed by `stripe listen`, whsec_...
#   STRIPE_API_BASE       leave empty for real Stripe; http://localhost:12111
#                         points the adapter at a local stripe-mock instead
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=

# First platform administrator (optional). Created at startup only while no
# platform user exists, then ignored. Not needed locally: the dev profile
# seeds platform@subscriptionhub.test / subscriptionhub. Password >= 12 chars.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Seeded local dev logins (created by Flyway migration V8).
# Not environment variables - recorded here because this is the file you
# copy when setting the project up, and these are the only credentials
# that exist until a user-management endpoint does.
#   acme -> admin@acme.test
#   demo -> admin@demo.test
#   password (both): subscriptionhub

# Metrics scrape account (MetricsSecurityConfig). The only credential that can
# read /actuator/prometheus. Leave both empty and metrics are unreadable (401).
# The local Prometheus in docker-compose.yml logs in as "prometheus", so keep
# that username if you use it. Password >= 16 chars.
METRICS_SCRAPE_USERNAME=prometheus
METRICS_SCRAPE_PASSWORD=dev-only-scrape-password

# Grafana (docker-compose.yml), http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin


# ---------------------------------------------------------------------------
# Deployment overrides.
#
# Every variable below has a working local default, so none of it is needed to
# run from a clean clone - that is the point of listing them. They exist so a
# deployed instance never needs a code change, and they are commented out so
# the local setup stays exactly as it was.
# ---------------------------------------------------------------------------

# Database. A managed provider hands you one complete URL rather than a
# database name, so the whole URL is overridable.
#
# DO NOT point DB_URL at a pooled endpoint. The tenant binding that row-level
# security depends on is session-level, and a transaction-mode pooler
# (PgBouncer, which is what Neon's and Supabase's pooled endpoints are) hands a
# different backend to each transaction. Every policy then reads an unbound
# tenant and returns nothing - silently, and only sometimes. Use the direct
# endpoint.
#
# The application role subscription_hub_app is created by
# docker/postgres/init/01-app-role.sh, which only runs via the Postgres image's
# init convention. A managed database needs that SQL run by hand before first
# boot, or V20's grants fail at startup.
#DB_URL=jdbc:postgresql://host:5432/dbname?sslmode=require
#DB_POOL_MAX=10
# Set to 0 on a database that scales to zero or bills for uptime; held idle
# connections keep it awake indefinitely.
#DB_POOL_MIN_IDLE=10

# Object store for invoice PDFs. s3mock locally, S3 when deployed.
#
# DELETE these four from the local block above, do not blank them:
#   STORAGE_ENDPOINT      unset -> the real regional S3 endpoint
#   STORAGE_ACCESS_KEY    unset -> the SDK's default credential chain
#   STORAGE_SECRET_KEY            (~/.aws/credentials, or an EC2 instance role)
#   STORAGE_PATH_STYLE    set to false for S3; s3mock needs true
#
# Bucket names are globally unique across every AWS account, so "invoices" is
# long gone. Block Public Access stays on: downloads stream through the API.
#STORAGE_BUCKET=subscription-hub-invoices-example
#STORAGE_REGION=eu-central-1
#STORAGE_PATH_STYLE=false
#
# Whether the application creates the bucket on first write. True locally and
# in tests, where not needing a provisioning step is the point. Set false
# wherever the bucket is infrastructure - then the write path issues no
# headBucket and no createBucket, so the credential needs only s3:GetObject
# and s3:PutObject, with no s3:ListBucket.
#STORAGE_CREATE_BUCKET=false

# SMTP. Mailpit locally on 1025 with no auth. A real relay needs all of
# MAIL_USERNAME, MAIL_PASSWORD, MAIL_AUTH=true, MAIL_STARTTLS=true and port
# 587 together - any one missing and it fails.
#
# SES's SMTP username and password are generated in the SES console (SMTP
# settings -> Create SMTP credentials). They are NOT an IAM access key and
# secret: the SMTP password is derived from an IAM secret by a signing
# algorithm, and assuming otherwise is the standard first mistake. The console
# creates a separate IAM user for them, distinct from whichever user holds the
# S3 and SQS policy - one credential for the data plane, one for mail.
#MAIL_HOST=email-smtp.eu-central-1.amazonaws.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_AUTH=true
#MAIL_STARTTLS=true
#
# NOTIFICATION_FROM. The default is a reserved .test TLD (RFC 2606) that any
# real relay rejects at the envelope, so this always has to be set.
#
# With a DOMAIN identity it can be anything at that domain - billing@, no-reply@.
# With an EMAIL ADDRESS identity (no domain to verify) it must be EXACTLY the
# verified address; SES refuses any other From. Two further consequences of
# taking that route, both observed rather than guessed:
#   - SES's sandbox verifies RECIPIENTS too, so mail can only go to verified
#     addresses. A demo customer therefore has to use that same address, and
#     the seeded *.test customers can never receive anything.
#   - SPF and DKIM align to amazonses.com while the From says, say, gmail.com,
#     so DMARC fails and the mail lands in spam. Marking it not-spam fixes one
#     mailbox and nothing else. The real fix is a domain: verify it, enable
#     Easy DKIM (three CNAMEs), point this at it. Config and DNS, not rework.
#NOTIFICATION_FROM=billing@example.com

# AWS / SQS.
#
# DELETE these three from the local block above, do not blank them:
#   SQS_ENDPOINT          unset -> the real regional SQS endpoint
#   AWS_ACCESS_KEY_ID     unset -> the SDK's default credential chain
#   AWS_SECRET_ACCESS_KEY
#
# The credentials matter especially: Spring Cloud AWS always injects whatever
# these resolve to, so a leftover placeholder silently beats an EC2 instance
# role.
#AWS_REGION=eu-central-1
# The queues are infrastructure: the application resolves them by name and
# never creates them. On real SQS, provision notifications and
# notifications-dlq with a redrive policy first (maxReceiveCount 5), matching
# docker/elasticmq/elasticmq.conf.
#NOTIFICATION_SQS_QUEUE=notifications

# Server and API docs.
#SERVER_PORT=8080
# Swagger UI sends "Try it out" requests here. Left at localhost on a deployed
# host, the UI fires them at the reader's own machine.
#OPENAPI_SERVER_URL=https://subscription-hub.example.com

# Schedules, as six-field Spring cron expressions. Shorten one to watch a job
# run locally - and pass it as an environment variable, never through
# -Dspring-boot.run.arguments, which Maven splits on spaces.
#BILLING_CYCLE_CRON=0 0 * * * *
#DUNNING_CYCLE_CRON=0 15 * * * *
#PAYMENT_RECONCILIATION_CRON=0 30 * * * *
#BILLING_INVOICE_DUE_DAYS=14
# Milliseconds between outbox relay polls. Every tick queries once per active
# tenant, so raise it on a database that scales to zero.
#NOTIFICATION_RELAY_DELAY=5000

# Payment provider: fake (the default, in-process, no network) or stripe.
#PAYMENT_PROVIDER=fake
