### Auth — log in as acme's seeded admin and capture the token.
### Every request below sends it as a bearer token. There is no
### X-Tenant-Id header any more: the tenant comes from the token's
### signed tenant_id claim, so a client can no longer choose it.
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "tenantId": "acme",
  "email": "admin@acme.test",
  "password": "subscriptionhub"
}

> {%
    client.global.set("acmeToken", response.body.token);
%}

### Auth — a second tenant, used only for the isolation checks below.
### Swapping a header used to be enough to act as another tenant; now it
### takes that tenant's own token, which makes those checks meaningful.
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "tenantId": "demo",
  "email": "admin@demo.test",
  "password": "subscriptionhub"
}

> {%
    client.global.set("demoToken", response.body.token);
%}


### Setup — create a Product for plans to reference
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "code": "messaging",
  "name": "Messaging API",
  "description": "Messaging platform"
}

### Create Plan — happy path
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "messaging",
  "code": "pro-monthly",
  "name": "Pro Monthly",
  "intervalUnit": "MONTH",
  "intervalCount": 1,
  "amountCents": 4999,
  "currency": "USD",
  "trialDays": 14
}

### Create Plan — omit currency, trialDays, and intervalCount
### (expects entity defaults: EUR, 0, 1)
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "messaging",
  "code": "basic-monthly",
  "name": "Basic Monthly",
  "intervalUnit": "MONTH",
  "amountCents": 999
}

### Create Plan — quarterly billing (intervalUnit MONTH, intervalCount 3)
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "messaging",
  "code": "pro-quarterly",
  "name": "Pro Quarterly",
  "intervalUnit": "MONTH",
  "intervalCount": 3,
  "amountCents": 13999,
  "currency": "USD"
}

### Create Plan — biennial billing (intervalUnit YEAR, intervalCount 2)
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "messaging",
  "code": "pro-biennial",
  "name": "Pro Biennial",
  "intervalUnit": "YEAR",
  "intervalCount": 2,
  "amountCents": 89999,
  "currency": "USD"
}

### Create Plan — duplicate code, same tenant (expects 409 PLAN_ALREADY_EXISTS)
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "messaging",
  "code": "pro-monthly",
  "name": "Duplicate Pro Monthly",
  "intervalUnit": "MONTH",
  "amountCents": 5999
}

### Create Plan — unknown productCode (expects 404 PRODUCT_NOT_FOUND)
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "does-not-exist",
  "code": "ghost-plan",
  "name": "Ghost Plan",
  "intervalUnit": "MONTH",
  "amountCents": 100
}

### Create Plan — invalid intervalUnit (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "messaging",
  "code": "weekly-plan",
  "name": "Weekly Plan",
  "intervalUnit": "WEEK",
  "amountCents": 100
}

### Create Plan — zero intervalCount (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "messaging",
  "code": "zero-interval-plan",
  "name": "Zero Interval Plan",
  "intervalUnit": "MONTH",
  "intervalCount": 0,
  "amountCents": 100
}

### List Plans
GET {{baseUrl}}/api/plans
Authorization: Bearer {{acmeToken}}

### List Plans — tenant isolation check (demo tenant should see none of acme's plans)
GET {{baseUrl}}/api/plans
Authorization: Bearer {{demoToken}}

### Get Plan — by code
GET {{baseUrl}}/api/plans/pro-monthly
Authorization: Bearer {{acmeToken}}

### Get Plan — unknown code (expects 404 PLAN_NOT_FOUND)
GET {{baseUrl}}/api/plans/does-not-exist
Authorization: Bearer {{acmeToken}}

### Get Plan — tenant isolation: acme's plan code under demo (expects 404 PLAN_NOT_FOUND)
GET {{baseUrl}}/api/plans/pro-monthly
Authorization: Bearer {{demoToken}}


### ============================================================
### PlanEntitlement — depends on pro-monthly existing (created above)
### ============================================================

### Create Entitlement — object value
POST {{baseUrl}}/api/plans/pro-monthly/entitlements
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "key": "max_users",
  "value": { "limit": 50 }
}

### Create Entitlement — boolean value
POST {{baseUrl}}/api/plans/pro-monthly/entitlements
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "key": "priority_support",
  "value": true
}

### Create Entitlement — duplicate key on same plan (expects 409 PLANENTITLEMENT_ALREADY_EXISTS)
POST {{baseUrl}}/api/plans/pro-monthly/entitlements
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "key": "max_users",
  "value": { "limit": 999 }
}

### Create Entitlement — same key on a DIFFERENT plan (expects 201 — key uniqueness is per-plan, not global)
POST {{baseUrl}}/api/plans/basic-monthly/entitlements
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "key": "max_users",
  "value": { "limit": 5 }
}

### Create Entitlement — unknown plan code (expects 404 PLAN_NOT_FOUND)
POST {{baseUrl}}/api/plans/does-not-exist/entitlements
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "key": "max_users",
  "value": { "limit": 10 }
}

### Create Entitlement — missing value (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/plans/pro-monthly/entitlements
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "key": "no_value_key"
}

### List Entitlements for pro-monthly
GET {{baseUrl}}/api/plans/pro-monthly/entitlements
Authorization: Bearer {{acmeToken}}

### List Entitlements — tenant isolation check
GET {{baseUrl}}/api/plans/pro-monthly/entitlements
Authorization: Bearer {{demoToken}}
