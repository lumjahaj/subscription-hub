### Auth — log in as acme's seeded admin and capture the token.
### Every request below sends it as a bearer token. There is no
### X-Tenant-Id header any more: the tenant comes from the token's
### signed tenant_id claim, so a client can no longer choose it.
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "tenantId": "acme",
  "email": "admin@acme.test",
  "password": "subscriptionhub"
}

> {%
    client.global.set("acmeToken", response.body.token);
%}

### Auth — a second tenant, used only for the isolation checks below.
### Swapping a header used to be enough to act as another tenant; now it
### takes that tenant's own token, which makes those checks meaningful.
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "tenantId": "demo",
  "email": "admin@demo.test",
  "password": "subscriptionhub"
}

> {%
    client.global.set("demoToken", response.body.token);
%}


### Setup — Product for usage tests
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "code": "usage-test-product",
  "name": "Usage Test Product"
}

### Setup — Plan (no trial, so the subscription starts ACTIVE)
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "usage-test-product",
  "code": "usage-test-plan",
  "name": "Usage Test Plan",
  "intervalUnit": "MONTH",
  "amountCents": 2999,
  "currency": "USD"
}

### Setup — Customer, capture id for use below
POST {{baseUrl}}/api/customers
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "email": "usage-test@acme.test",
  "name": "Usage Test Customer"
}

> {%
    client.global.set("usageCustomerId", response.body.id);
%}

### Setup — Subscription, capture id for use below
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "customerId": "{{usageCustomerId}}",
  "planCode": "usage-test-plan"
}

> {%
    client.global.set("usageSubId", response.body.id);
%}


### Record usage — first call for a meter (expects 200, amount 10)
POST {{baseUrl}}/api/subscriptions/{{usageSubId}}/usage
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "meterKey": "emails.sent",
  "amount": 10
}

### Record usage — second call for the SAME meter (expects 200, amount accumulates to 25)
POST {{baseUrl}}/api/subscriptions/{{usageSubId}}/usage
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "meterKey": "emails.sent",
  "amount": 15
}

### Record usage — a DIFFERENT meter on the same subscription (expects 200, separate counter)
POST {{baseUrl}}/api/subscriptions/{{usageSubId}}/usage
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "meterKey": "api.calls",
  "amount": 3.5
}

### Record usage — zero amount (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/subscriptions/{{usageSubId}}/usage
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "meterKey": "emails.sent",
  "amount": 0
}

### Record usage — negative amount (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/subscriptions/{{usageSubId}}/usage
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "meterKey": "emails.sent",
  "amount": -5
}

### Record usage — missing meterKey (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/subscriptions/{{usageSubId}}/usage
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "amount": 1
}

### Record usage — unknown subscription id (expects 404 SUBSCRIPTION_NOT_FOUND)
POST {{baseUrl}}/api/subscriptions/00000000-0000-0000-0000-000000000000/usage
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "meterKey": "emails.sent",
  "amount": 1
}

### Record usage — tenant isolation: acme's subscription id under demo
### (expects 404 SUBSCRIPTION_NOT_FOUND — must not leak or succeed)
POST {{baseUrl}}/api/subscriptions/{{usageSubId}}/usage
Content-Type: application/json
Authorization: Bearer {{demoToken}}

{
  "meterKey": "emails.sent",
  "amount": 1
}

### List usage for the subscription — expects two counters (emails.sent=25, api.calls=3.5)
GET {{baseUrl}}/api/subscriptions/{{usageSubId}}/usage
Authorization: Bearer {{acmeToken}}

### List usage — tenant isolation check (demo must not see acme's counters)
GET {{baseUrl}}/api/subscriptions/{{usageSubId}}/usage
Authorization: Bearer {{demoToken}}


### Setup — a subscription to cancel, to test the CANCELED guard
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "customerId": "{{usageCustomerId}}",
  "planCode": "usage-test-plan"
}

> {%
    client.global.set("usageCanceledSubId", response.body.id);
%}

### Cancel it
POST {{baseUrl}}/api/subscriptions/{{usageCanceledSubId}}/cancel
Authorization: Bearer {{acmeToken}}

### Record usage — against a CANCELED subscription (expects 409 INVALID_SUBSCRIPTION_STATE)
POST {{baseUrl}}/api/subscriptions/{{usageCanceledSubId}}/usage
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "meterKey": "emails.sent",
  "amount": 1
}
