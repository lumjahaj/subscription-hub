### Auth — log in as acme's seeded admin and capture the token.
### Every request below sends it as a bearer token. There is no
### X-Tenant-Id header any more: the tenant comes from the token's
### signed tenant_id claim, so a client can no longer choose it.
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "tenantId": "acme",
  "email": "admin@acme.test",
  "password": "subscriptionhub"
}

> {%
    client.global.set("acmeToken", response.body.token);
%}

### Auth — a second tenant, used only for the isolation checks below.
### Swapping a header used to be enough to act as another tenant; now it
### takes that tenant's own token, which makes those checks meaningful.
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "tenantId": "demo",
  "email": "admin@demo.test",
  "password": "subscriptionhub"
}

> {%
    client.global.set("demoToken", response.body.token);
%}


### Setup — Product for subscription tests
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "code": "sub-test-product",
  "name": "Subscription Test Product"
}

### Setup — Plan WITH a trial (14 days)
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "sub-test-product",
  "code": "sub-trial-monthly",
  "name": "Trial Monthly",
  "intervalUnit": "MONTH",
  "amountCents": 2999,
  "currency": "USD",
  "trialDays": 14
}

### Setup — Plan WITHOUT a trial
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "sub-test-product",
  "code": "sub-notrial-monthly",
  "name": "No Trial Monthly",
  "intervalUnit": "MONTH",
  "amountCents": 1999,
  "currency": "USD"
}

### Setup — Customer, capture id for use below
POST {{baseUrl}}/api/customers
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "email": "sub-test@acme.test",
  "name": "Subscription Test Customer"
}

> {%
    client.global.set("customerId", response.body.id);
%}


### Create Subscription — WITH trial (expects status TRIALING, currentPeriodEnd ~14 days out)
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "customerId": "{{customerId}}",
  "planCode": "sub-trial-monthly"
}

### Create Subscription — WITHOUT trial (expects status ACTIVE, currentPeriodEnd ~1 month out)
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "customerId": "{{customerId}}",
  "planCode": "sub-notrial-monthly"
}

### Create Subscription — unknown customerId (expects 404 CUSTOMER_NOT_FOUND)
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "customerId": "00000000-0000-0000-0000-000000000000",
  "planCode": "sub-trial-monthly"
}

### Create Subscription — unknown planCode (expects 404 PLAN_NOT_FOUND)
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "customerId": "{{customerId}}",
  "planCode": "does-not-exist"
}

### Create Subscription — missing customerId (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "planCode": "sub-trial-monthly"
}

### Create Subscription — missing planCode (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "customerId": "{{customerId}}"
}

### Create Subscription — tenant isolation check: acme's customerId/planCode used
### under demo tenant (expects 404 CUSTOMER_NOT_FOUND — neither the customer
### nor the plan exist for the demo tenant, so this must NOT succeed)
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{demoToken}}

{
  "customerId": "{{customerId}}",
  "planCode": "sub-trial-monthly"
}

### List Subscriptions — all, for acme
GET {{baseUrl}}/api/subscriptions
Authorization: Bearer {{acmeToken}}

### List Subscriptions — filtered by customerId
GET {{baseUrl}}/api/subscriptions?customerId={{customerId}}
Authorization: Bearer {{acmeToken}}

### List Subscriptions — tenant isolation check (demo should see none of these)
GET {{baseUrl}}/api/subscriptions
Authorization: Bearer {{demoToken}}


### Setup — Subscription for state-transition tests (trial plan -> TRIALING)
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "customerId": "{{customerId}}",
  "planCode": "sub-trial-monthly"
}

> {%
    client.global.set("transitionSubId", response.body.id);
%}

### Get Subscription — by id
GET {{baseUrl}}/api/subscriptions/{{transitionSubId}}
Authorization: Bearer {{acmeToken}}

### Get Subscription — unknown id (expects 404 SUBSCRIPTION_NOT_FOUND)
GET {{baseUrl}}/api/subscriptions/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{acmeToken}}

### Get Subscription — tenant isolation: acme's id under demo (expects 404 SUBSCRIPTION_NOT_FOUND)
GET {{baseUrl}}/api/subscriptions/{{transitionSubId}}
Authorization: Bearer {{demoToken}}

### Pause — TRIALING -> PAUSED (expects 200, status PAUSED)
POST {{baseUrl}}/api/subscriptions/{{transitionSubId}}/pause
Authorization: Bearer {{acmeToken}}

### Pause — already PAUSED (expects 409 INVALID_SUBSCRIPTION_STATE)
POST {{baseUrl}}/api/subscriptions/{{transitionSubId}}/pause
Authorization: Bearer {{acmeToken}}

### Resume — PAUSED -> ACTIVE (expects 200, status ACTIVE)
POST {{baseUrl}}/api/subscriptions/{{transitionSubId}}/resume
Authorization: Bearer {{acmeToken}}

### Resume — not PAUSED (expects 409 INVALID_SUBSCRIPTION_STATE)
POST {{baseUrl}}/api/subscriptions/{{transitionSubId}}/resume
Authorization: Bearer {{acmeToken}}

### Cancel — ACTIVE -> CANCELED (expects 200, status CANCELED, canceledAt set)
POST {{baseUrl}}/api/subscriptions/{{transitionSubId}}/cancel
Authorization: Bearer {{acmeToken}}

### Cancel — already CANCELED (expects 409 INVALID_SUBSCRIPTION_STATE)
POST {{baseUrl}}/api/subscriptions/{{transitionSubId}}/cancel
Authorization: Bearer {{acmeToken}}

### Pause — a CANCELED subscription (expects 409 INVALID_SUBSCRIPTION_STATE)
POST {{baseUrl}}/api/subscriptions/{{transitionSubId}}/pause
Authorization: Bearer {{acmeToken}}

### Cancel — tenant isolation: demo tries to cancel acme's subscription id
### (expects 404 SUBSCRIPTION_NOT_FOUND — must not leak or succeed)
POST {{baseUrl}}/api/subscriptions/{{transitionSubId}}/cancel
Authorization: Bearer {{demoToken}}

### Cancel — unknown subscription id (expects 404 SUBSCRIPTION_NOT_FOUND)
POST {{baseUrl}}/api/subscriptions/00000000-0000-0000-0000-000000000000/cancel
Authorization: Bearer {{acmeToken}}

###############################################################################
# Plan changes
#
# A plan change is scheduled, never immediate. The subscription stays on its
# current plan and in its current period; the swap happens at the next renewal,
# which BillingCycleJob runs *after* invoicing the closed period. That ordering
# is what keeps the closed period billed at the price the customer was actually
# on - an immediate swap would reprice a period already spent on the old plan.
###############################################################################

### Setup — an annual plan to move onto. A different interval makes the effect
### visible: after the change applies, the new period is a year, not a month.
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "sub-test-product",
  "code": "sub-annual",
  "name": "Annual",
  "intervalUnit": "YEAR",
  "amountCents": 19999,
  "currency": "USD"
}

### Setup — a subscription to change, on the no-trial monthly plan
POST {{baseUrl}}/api/subscriptions
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "customerId": "{{customerId}}",
  "planCode": "sub-notrial-monthly"
}

> {%
    client.global.set("planChangeSubId", response.body.id);
%}

### Schedule a plan change (expects 200; planCode unchanged,
### pendingPlanCode = sub-annual, period and nextRenewal untouched)
POST {{baseUrl}}/api/subscriptions/{{planChangeSubId}}/change-plan
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "planCode": "sub-annual"
}

### Schedule the same change again (expects 200 and an identical body —
### an idempotent command, so a satisfied intent is a no-op, not a 409.
### updatedAt must not move.)
POST {{baseUrl}}/api/subscriptions/{{planChangeSubId}}/change-plan
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "planCode": "sub-annual"
}

### Read it back (expects 200, pendingPlanCode = sub-annual)
GET {{baseUrl}}/api/subscriptions/{{planChangeSubId}}
Authorization: Bearer {{acmeToken}}

### Cancel the scheduled change (expects 200, pendingPlanCode null)
DELETE {{baseUrl}}/api/subscriptions/{{planChangeSubId}}/change-plan
Authorization: Bearer {{acmeToken}}

### Cancel it again (expects 200 and no change — nothing was scheduled)
DELETE {{baseUrl}}/api/subscriptions/{{planChangeSubId}}/change-plan
Authorization: Bearer {{acmeToken}}

### Re-schedule, then ask for the plan it is already on (expects 200 with
### pendingPlanCode null) — "stay on this plan" clears the schedule rather
### than storing a change to nothing.
POST {{baseUrl}}/api/subscriptions/{{planChangeSubId}}/change-plan
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "planCode": "sub-annual"
}

###
POST {{baseUrl}}/api/subscriptions/{{planChangeSubId}}/change-plan
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "planCode": "sub-notrial-monthly"
}

### Unknown planCode (expects 404 PLAN_NOT_FOUND)
POST {{baseUrl}}/api/subscriptions/{{planChangeSubId}}/change-plan
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "planCode": "does-not-exist"
}

### Missing planCode (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/subscriptions/{{planChangeSubId}}/change-plan
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
}

### A CANCELED subscription (expects 409 INVALID_SUBSCRIPTION_STATE) —
### it will never renew, so there is no boundary to schedule for.
POST {{baseUrl}}/api/subscriptions/{{transitionSubId}}/change-plan
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "planCode": "sub-annual"
}

### Tenant isolation — demo schedules a change on acme's subscription
### (expects 404 SUBSCRIPTION_NOT_FOUND; must not leak or succeed)
POST {{baseUrl}}/api/subscriptions/{{planChangeSubId}}/change-plan
Content-Type: application/json
Authorization: Bearer {{demoToken}}

{
  "planCode": "sub-annual"
}

### Tenant isolation — demo clears a change on acme's subscription
### (expects 404 SUBSCRIPTION_NOT_FOUND)
DELETE {{baseUrl}}/api/subscriptions/{{planChangeSubId}}/change-plan
Authorization: Bearer {{demoToken}}

### Audit trail (expects SUBSCRIPTION_PLAN_CHANGE_SCHEDULED /
### _CANCELED entries; SUBSCRIPTION_PLAN_CHANGED with actorType SYSTEM
### appears only once BillingCycleJob has applied the change)
GET {{baseUrl}}/api/audit-events?entityType=SUBSCRIPTION&entityId={{planChangeSubId}}
Authorization: Bearer {{acmeToken}}
