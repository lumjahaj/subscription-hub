### Auth — log in as acme's seeded admin and capture the token.
### Every request below sends it as a bearer token. There is no
### X-Tenant-Id header any more: the tenant comes from the token's
### signed tenant_id claim, so a client can no longer choose it.
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "tenantId": "acme",
  "email": "admin@acme.test",
  "password": "subscriptionhub"
}

> {%
    client.global.set("acmeToken", response.body.token);
%}

### Auth — a second tenant, used only for the isolation checks below.
### Swapping a header used to be enough to act as another tenant; now it
### takes that tenant's own token, which makes those checks meaningful.
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "tenantId": "demo",
  "email": "admin@demo.test",
  "password": "subscriptionhub"
}

> {%
    client.global.set("demoToken", response.body.token);
%}


### Create Product — happy path
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "code": "messaging",
  "name": "Messaging API",
  "description": "Messaging platform"
}

### Create Product — no description (optional field)
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "code": "analytics",
  "name": "Analytics API"
}

### Create Product — duplicate code, same tenant (expects 409 PRODUCT_ALREADY_EXISTS)
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "code": "messaging",
  "name": "Messaging API Duplicate",
  "description": "Should be rejected"
}

### Create Product — same code, different tenant (expects 201 — tenant isolation check)
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{demoToken}}

{
  "code": "messaging",
  "name": "Messaging API (demo tenant)",
  "description": "Same code as acme's product, different tenant — must succeed"
}

### Create Product — missing code (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "name": "No Code Product"
}

### Create Product — blank name (expects 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "code": "no-name",
  "name": ""
}

### Create Product — no token (expects 401 UNAUTHENTICATED)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "code": "no-token",
  "name": "No Token Product"
}

### Create Product — a token that isn't one (expects 401)
# The old "unknown tenant" case is gone: a caller can no longer name a
# tenant at all, only present a token that proves which one they belong to.
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer not.a.real.token

{
  "code": "ghost",
  "name": "Ghost Product"
}

### List Products — default paging
GET {{baseUrl}}/api/products
Authorization: Bearer {{acmeToken}}

### List Products — explicit page/size
GET {{baseUrl}}/api/products?page=0&size=5
Authorization: Bearer {{acmeToken}}

### List Products — sorted by name
GET {{baseUrl}}/api/products?sort=name,asc
Authorization: Bearer {{acmeToken}}

### List Products — tenant isolation check (demo tenant should NOT see acme's products)
GET {{baseUrl}}/api/products
Authorization: Bearer {{demoToken}}

### Get Product — by code
GET {{baseUrl}}/api/products/messaging
Authorization: Bearer {{acmeToken}}

### Get Product — unknown code (expects 404 PRODUCT_NOT_FOUND)
GET {{baseUrl}}/api/products/does-not-exist
Authorization: Bearer {{acmeToken}}

### Get Product — tenant isolation: demo also has a "messaging" product (created above).
### Must return demo's own row (name "Messaging API (demo tenant)"), not acme's.
GET {{baseUrl}}/api/products/messaging
Authorization: Bearer {{demoToken}}


### --- ROLE-BASED ACCESS ---
### Reads are open to any authenticated role; writes carry an explicit
### @PreAuthorize. Catalog writes are ADMIN-only, because someone who can
### run billing should not be able to quietly change what the prices are.

### Auth — log in as the seeded SUPPORT user (read-only role)
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "tenantId": "acme",
  "email": "support@acme.test",
  "password": "subscriptionhub"
}

> {%
    client.global.set("supportToken", response.body.token);
%}

### List Products as SUPPORT (expects 200 — reads need no role)
GET {{baseUrl}}/api/products
Authorization: Bearer {{supportToken}}

### Create Product as SUPPORT (expects 403 ACCESS_DENIED)
### Note this is 403, not 401: the caller is authenticated, just not
### permitted. And not 500 — @PreAuthorize throws during dispatch, so
### without an explicit AccessDeniedException handler the catch-all
### advice would report a forbidden request as an internal error.
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{supportToken}}

{
  "code": "support-denied",
  "name": "Should Be Denied"
}

### ---------------------------------------------------------------------
### Requests Spring rejects before any controller runs. Each is the
### caller's mistake, so each is a 4xx problem+json with a code - these
### all used to fall through to the catch-all as 500 INTERNAL_ERROR.
### Uses acme's ADMIN token from the top of this file.
### ---------------------------------------------------------------------

### Body is not JSON (expects 400 MALFORMED_REQUEST_BODY)
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{"code": "broken",

### Field of the wrong type (expects 400 MALFORMED_REQUEST_BODY naming
### amountCents, without echoing the value or naming the DTO class)
POST {{baseUrl}}/api/plans
Content-Type: application/json
Authorization: Bearer {{acmeToken}}

{
  "productCode": "whatever",
  "code": "wrong-type",
  "name": "Wrong Type",
  "intervalUnit": "MONTH",
  "amountCents": "ten",
  "currency": "EUR"
}

### Unsupported method (expects 405 METHOD_NOT_ALLOWED with an Allow header)
DELETE {{baseUrl}}/api/products
Authorization: Bearer {{acmeToken}}

### Unsupported content type (expects 415 UNSUPPORTED_MEDIA_TYPE)
POST {{baseUrl}}/api/products
Content-Type: text/plain
Authorization: Bearer {{acmeToken}}

code=plain-text

### Unknown URL with a token (expects 404 ENDPOINT_NOT_FOUND)
GET {{baseUrl}}/api/no-such-endpoint
Authorization: Bearer {{acmeToken}}

### Unknown URL without a token (expects 401 - authentication comes first,
### so an anonymous caller cannot probe which endpoints exist)
GET {{baseUrl}}/api/no-such-endpoint
